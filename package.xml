<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>executor_tools</name>
  <version>0.0.0</version>
  <description>Utilities for executor</description>
  <maintainer email="marco.soriano5102@comunidad.unam.mx">Marco Soriano</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- C++ / Build -->
  <depend>ament_index_cpp</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>geometry_msgs</depend>
  <depend>rcl_interfaces</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>

  <!-- Tools -->
  <depend>hri_tools</depend>
  <depend>navigation_tools</depend>
  <depend>hardware_tools</depend>
  <depend>vision_tools</depend>
  <depend>vision_interfaces</depend>
  <depend>manipulation_tools</depend>
  <depend>planning_tools</depend>
  <depend>knowledge_tools</depend>

  <!-- Interfaces -->
  <depend>executor_interfaces</depend>

  <!-- Test -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
