<?xml version="1.0" encoding="UTF-8"?>
<launch>

    <node
        pkg="tasks"
        exec="find_person_action"
        name="find_person_action">
    </node>

    <node
        pkg="tasks"
        exec="find_seat_action"
        name="find_seat_action">
    </node>

    <node
        pkg="tasks"
        exec="find_object_action"
        name="find_object_action">
    </node>

    <node
      pkg="tasks"
      exec="table_align"
      name="table_align"
      output="screen">
        <param name="tolerance" value="5.0"/>
    </node>

    <node
        pkg="tasks"
        exec="find_waving_action"
        name="find_waving_action">
    </node>

    <node
        pkg="tasks"
        exec="take_node"
        name="take_node">
    </node>

</launch>

